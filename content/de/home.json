{
    "title": "Kaderblick Hilfe und Dokumentation",
    "hero": {
        "heading": "Kaderblick sicher verstehen und bedienen",
        "lead": "Anleitungen für den gesamten Vereinsalltag – vom ersten Zugang über Team- und Spielorganisation bis zu Auswertungen, Kasse, Inventar und Administration.",
        "eyebrow": "Kaderblick Hilfezentrum",
        "chips": [
            "Schritt für Schritt",
            "Nach Rollen erklärt",
            "Desktop und Mobilgerät"
        ]
