{# Sub-navigation for camera detail pages. #}
{# Parameters: base_route (string), current_path (string). #}
<nav class="subnav">
    <a href="{{ path(base_route) }}"
       class="subnav__link {{ current_path == path(base_route) ? 'subnav__link--active' : '' }}">
        Übersicht
    </a>
    <a href="{{ path(base_route ~ '_assembly') }}"
       class="subnav__link {{ current_path == path(base_route ~ '_assembly') ? 'subnav__link--active' : '' }}">
        🔧 Bauanleitung
    </a>
    <a href="{{ path(base_route ~ '_3d_view') }}"
       class="subnav__link {{ current_path == path(base_route ~ '_3d_view') ? 'subnav__link--active' : '' }}">
        🧊 3D-Ansicht
    </a>
    <a href="{{ path(base_route ~ '_software') }}"
       class="subnav__link {{ current_path == path(base_route ~ '_software') ? 'subnav__link--active' : '' }}">
        💻 Software
    </a>
    <a href="{{ path(base_route ~ '_parts_list') }}"
       class="subnav__link {{ current_path == path(base_route ~ '_parts_list') ? 'subnav__link--active' : '' }}">
        📋 Teileliste
    </a>
</nav>
