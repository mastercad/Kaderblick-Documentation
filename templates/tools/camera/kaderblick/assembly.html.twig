{% extends 'base.html.twig' %}

{% block title %}Bauanleitung – Kaderblick-Kamera – docs.kaderblick.de{% endblock %}

{% block body %}
<article class="docs-page">
    {% include 'components/docs_hero.html.twig' with {
        heading: 'Bauanleitung – Kaderblick-Kamera',
        lead: 'Schritt-für-Schritt-Anleitung zum Aufbau des Kaderblick-Kamerasystems. Das Gehäuse besteht aus lasergeschnittenem Sperrholz (3 mm und 5 mm), die Teile werden per Fingerverbindung zusammengesteckt, geklebt und anschließend lackiert.'
    } only %}

    {% include 'components/camera_subnav.html.twig' with {
        base_route: 'docs_kaderblick_camera',
        current_path: app.request.pathInfo
    } %}

    {% include 'components/callout.html.twig' with {
        type: 'warning',
        title: 'Voraussetzungen',
        text: 'Grundkenntnisse in Holzbearbeitung und Elektronik werden empfohlen. Zugang zu einem Lasercutter ist erforderlich. Alle benötigten Bauteile sind in der <a href="' ~ path('docs_kaderblick_camera_parts_list') ~ '">Teileliste</a> aufgeführt.'
    } %}

    {# ─── Bauabschnitte ─── #}
    <h2>Bauabschnitte</h2>
    {% include 'components/steps.html.twig' with {
        steps: [
            { title: 'Schnittmuster lasern', text: 'Alle Gehäuseteile aus 3 mm und 5 mm Sperrholz auf dem Lasercutter ausschneiden. Die Fingerverbindungen sorgen für passgenaue Verbindungen zwischen den Wandteilen.' },
            { title: 'Teile zusammenstecken', text: 'Alle Wandteile über die Fingerverbindungen zusammenstecken und die Passform prüfen, bevor geklebt wird.' },
            { title: 'Kleben', text: 'Das Gehäuse mit Holzleim verkleben. Die Fingerverbindungen geben von sich aus ausreichend Stabilität – Teile sauber ausrichten und fixieren, bis der Leim ausgehärtet ist.' },
            { title: 'Verankerungsbleche montieren', text: 'Metallbleche an den kritischen Stellen einsetzen und befestigen, um ein Aufspalten des Holzes dauerhaft zu verhindern.' },
            { title: 'Stativaufnahme befestigen', text: 'Den 20-mm-Stativzapfen-Adapter an der Unterseite des Gehäuses montieren.' },
            { title: 'Güsösen eindrehen', text: 'Die beiden Schraubgüsösen für die Befestigung am 8-Meter-Stativ eindrehen – die Kamera hängt von unten am Stativ.' },
            { title: 'Schleifen und lackieren', text: 'Oberfläche fein schleifen und mit Laubgrün RAL 6002 lackieren. Mehrere dünne Schichten ergeben ein gleichmäßiges Ergebnis.' },
            { title: 'Elektronik einbauen', text: 'Raspberry Pi, Kameras, Festplatten, Motoren und Stromversorgung einsetzen und verkabeln.' },
            { title: 'Funktionstest', text: 'System einschalten und prüfen: Aufnahme, Netzwerkverbindung, Motorsteuerung und automatischer Start.' },
        ]
    } %}

    {% include 'components/callout.html.twig' with {
        type: 'tip',
        title: 'Tipp',
        text: 'Jeden Bauschritt mit Fotos dokumentieren – das hilft bei der Fehlersuche und bei späteren Nachbauten.'
    } %}
</article>
{% endblock %}
