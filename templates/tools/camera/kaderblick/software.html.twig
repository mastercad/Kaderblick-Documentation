{% extends 'base.html.twig' %}

{% block title %}Software – Kaderblick-Kamera – docs.kaderblick.de{% endblock %}

{% block body %}
<article class="docs-page">
    {% include 'components/docs_hero.html.twig' with {
        heading: 'Software – Kaderblick-Kamera',
        lead: 'Das Kaderblick-Kamerasystem wird durch zwei eigenentwickelte Software-Komponenten gesteuert: eine REST-API auf den Raspberry Pis und eine Android-App zur Fernsteuerung und Überwachung. Zusätzlich gibt es den VideoManager als separates Tool.'
    } only %}

    {% include 'components/camera_subnav.html.twig' with {
        base_route: 'docs_kaderblick_camera',
        current_path: app.request.pathInfo
    } %}

    {# ─── Komponenten ─── #}
    <h2>Komponenten</h2>
    {% include 'components/feature_list.html.twig' with {
        features: [
            { icon: '🖥️', title: 'Kamera-API (Raspberry Pi)', desc: 'Läuft auf jedem der beiden Raspberry Pis. Greift das Kamerabild der angeschlossenen Arducam ab und stellt es über eine REST-Schnittstelle bereit. Alle Kameraparameter und Aufnahmen werden darüber gesteuert.' },
            { icon: '📱', title: 'CameraControl (Android)', desc: 'Android-App zur Steuerung und Überwachung beider Kamerasysteme über die REST-API.' },
            { icon: '🎞️', title: 'VideoManager', desc: 'Separates Tool zur Verwaltung und Verarbeitung der Aufnahmen – dokumentiert im Bereich Tools.' },
        ]
    } %}

    {# ─── CameraControl ─── #}
    <h2>CameraControl – Funktionen</h2>
    {% include 'components/feature_list.html.twig' with {
        features: [
            { icon: '🖼️', title: 'Live-Vorschau', desc: 'Das empfangene Kamerabild beider Systeme wird direkt in der App angezeigt.' },
            { icon: '⚙️', title: 'Kameraeinstellungen', desc: 'Auflösung, Belichtungszeit, Belichtungsmodus, Sättigung, Helligkeit und weitere Parameter sind direkt in der App einstellbar.' },
            { icon: '❤️', title: 'Systemüberwachung', desc: 'Gesundheitsstatus beider Kamerasysteme auf einen Blick – Verbindung, Speicher, allgemeiner Systemzustand.' },
            { icon: '⏯️', title: 'Aufnahme-Steuerung', desc: 'Aufnahme anhalten oder neu starten, Kameras neu booten oder herunterfahren – alles per App aus der Ferne.' },
        ]
    } %}
</article>
{% endblock %}
