{% extends 'base.html.twig' %}

{% block title %}3D-Ansicht – Kaderblick-Kamera – docs.kaderblick.de{% endblock %}

{% block head_extras %}
<script type="importmap">
{
    "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.164.1/examples/jsm/"
    }
}
</script>
{% endblock %}

{% block body %}
    <h1>🧊 3D-Ansicht – Kaderblick-Kamera</h1>

    {% include 'components/kamera_subnav.html.twig' with {
        base_route: 'app_tools_kamera_kaderblick',
        current_path: app.request.pathInfo
    } %}

    <p>
        Interaktive 3D-Darstellung des Kaderblick-Kameragehäuses. Dreh das Modell per Maus oder Touch.
        Klicke in der Teilekarte auf ein Bauteil, um es im 3D-Modell anzufliegen und hervorzuheben.
        Innere Bauteile öffnen das Gehäuse automatisch als Explosionsansicht.
    </p>

    {% include 'components/kaderblick_3d_viewer.html.twig' %}
{% endblock %}
